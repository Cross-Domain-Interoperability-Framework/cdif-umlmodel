            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#Real"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.Dataset.version.lower" xmi:uuid="87e92c50-5f00-58f4-8276-c43229d914f3">
              <value>0</value>
            </lowerValue>
