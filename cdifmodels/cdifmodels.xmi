            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.InstanceVariable.InstanceVariable_cdi_takesSubstantiveValuesFrom_SubstantiveValueDomain" xmi:uuid="e2ca7a83-16c7-51d1-a61a-1f394d075568">
