              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="skos.Concept.altLabel.upper" xmi:uuid="19c827dc-3f34-545e-95e4-34095bf0ef2d">
