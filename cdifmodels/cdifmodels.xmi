            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.RepresentedVariable.descriptiveText.lower" xmi:uuid="8e18ad28-0640-5f8d-9269-599fcf93dc9c">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.RepresentedVariable.descriptiveText.upper" xmi:uuid="73597f3e-f5e8-574a-888d-8976ca9ae35f">
