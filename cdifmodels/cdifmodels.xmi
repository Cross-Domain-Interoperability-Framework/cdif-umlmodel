            <name>cdi:description</name>
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.ValueAndConceptDescription.cdi_description.lower" xmi:uuid="f4f86ab4-3a19-56cf-8e0e-7f7896a5b54d">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.ValueAndConceptDescription.cdi_description.upper" xmi:uuid="b766ab63-0ce0-51fe-ac48-cf3fc7823963">
