            <ownedComment xmi:type="uml:Comment" xmi:id="schema.DataCatalog.name.comment" xmi:uuid="d5319fb5-dee4-53c8-85a6-210fad0cfd15">
              <body>**CDIF**

Definition
==========

Label for the data catalog.</body>
