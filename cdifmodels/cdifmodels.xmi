          <ownedAttribute xmi:type="uml:Property" xmi:id="schema.DataDownload.DataDownload_cdi_isStructuredBy_DimensionalDataStructure" xmi:uuid="426b2fcf-58a5-5976-b022-df39160af147">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="schema.DataDownload.DataDownload_cdi_isStructuredBy_DimensionalDataStructure.lower" xmi:uuid="94be1e0e-9db5-5829-8209-d284955c79af">
