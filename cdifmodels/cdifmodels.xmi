            <type xmi:idref="schema.WebAPI"/>
          </ownedEnd>
          <memberEnd xmi:idref="assoc.WebAPI_serviceType_DefinedTerm.ownedEnd"/>
          <memberEnd xmi:idref="schema.WebAPI.WebAPI_serviceType_DefinedTerm"/>
        </packagedElement>
