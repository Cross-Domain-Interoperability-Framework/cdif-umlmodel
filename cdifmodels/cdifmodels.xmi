        <packagedElement xmi:type="uml:Class" xmi:id="cdif.AttributeComponent" xmi:uuid="490ea381-5cfe-500d-8bef-7959fba53349">
          <name>AttributeComponent</name>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.AttributeComponent.comment" xmi:uuid="361b36cb-4de3-5f99-95be-5d02eb17b2be">
            <body>**CDIF**

Definition
==========

Role given to a represented variable in the context of a data structure to qualify observations or provide other supplementary information. Permitted in all three concrete DataStructure subtypes.</body>
            <annotatedElement xmi:idref="cdif.AttributeComponent"/>
          </ownedComment>
          <generalization xmi:type="uml:Generalization" xmi:id="cdif.AttributeComponent.gen.DataStructureComponent" xmi:uuid="33e2c173-06ad-5907-ad25-2f16d68d7bbc">
