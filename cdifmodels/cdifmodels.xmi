        <packagedElement xmi:type="uml:Association" xmi:id="assoc.DataDownload_cdif_coTypedAs_AbstractDataSet" xmi:uuid="5b2c6ecc-c2af-529a-a079-ff8c4a55a630">
          <name>DataDownload_cdif:coTypedAs_AbstractDataSet</name>
          <ownedComment xmi:type="uml:Comment" xmi:id="assoc.DataDownload_cdif_coTypedAs_AbstractDataSet.comment" xmi:uuid="9c696251-da97-55b2-9d3a-08423cc546e1">
            <body>**CDIF**

Definition
==========

PROPOSED, not extracted: represents a DataDownload optionally being additionally co-typed as a TabularTextDataSet or StructuredDataSet, per config's own 'co-type a DataDownload may declare' framing - modeled as an association rather than a Generalization from DataDownload, since config's definition describes an orthogonal co-typing, not a further specialization within the existing AbstractDistribution branch.</body>
            <annotatedElement xmi:idref="assoc.DataDownload_cdif_coTypedAs_AbstractDataSet"/>
          </ownedComment>
          <ownedEnd xmi:type="uml:Property" xmi:id="assoc.DataDownload_cdif_coTypedAs_AbstractDataSet.ownedEnd" xmi:uuid="fbe5d46e-56f3-5e75-8fff-75089ebdac42">
