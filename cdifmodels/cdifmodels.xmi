              <value>1</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="schema.ContactPoint.email.upper" xmi:uuid="6e8025f7-fd99-5d57-81b8-628591d5cecd">
              <value>1</value>
            </upperValue>
            <ownedComment xmi:type="uml:Comment" xmi:id="schema.ContactPoint.email.comment" xmi:uuid="810b4c53-6960-5412-92a2-fe9aa2f7380a">
              <body>**CDIF**

Definition
==========

Property is required if a contactPoint property is included. Use missing@example.org if e-mail address is not available. Recommend using position-based contact point because people move around.</body>
              <annotatedElement xmi:idref="schema.ContactPoint.email"/>
            </ownedComment>
          </ownedAttribute>
