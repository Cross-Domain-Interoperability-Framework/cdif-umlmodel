          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.RepresentedVariable.cdi_identifier" xmi:uuid="e720a3e6-1b38-54d1-bc73-3fa7ea35b159">
            <name>cdi:identifier</name>
            <type xmi:idref="schema.Identifier"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.RepresentedVariable.cdi_identifier.lower" xmi:uuid="7dc8b2d3-7e36-5a67-82f5-2700e62e2820">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.RepresentedVariable.cdi_identifier.upper" xmi:uuid="760b78df-6a5c-5556-b9d4-997c6841a9d4">
              <value>1</value>
            </upperValue>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.RepresentedVariable.cdi_identifier.comment" xmi:uuid="45f41f67-4165-592d-a993-ba5e5a9c0bf0">
              <body>**CDIF**

Definition
==========

``@id`` reference to a ``schema:Identifier``.  Identify this variable definition in a global context for use in other documents.

**Original (DDICDI)**

*Definition:* An unambiguous reference to the resource within a given context. Recommended practice is to identify the resource by means of a string conforming to an identification system. Examples include International Standard Book Number (ISBN), Digital Object Identifier (DOI), and Uniform Resource Name (URN). Persistent identifiers should be provided as HTTP URIs. (See DCMI Metadata Terms - https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/identifier.)

`Specification item reference &lt;https://ddi-cdi.github.io/m2t-ng/DDI-CDI_1-1beta/field-level-documentation/DDICDILibrary/Classes/Conceptual/RepresentedVariable.html&gt;`__</body>
              <annotatedElement xmi:idref="cdif.RepresentedVariable.cdi_identifier"/>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.RepresentedVariable.cdi_hasIntendedDataType" xmi:uuid="6759b124-3494-5c8a-b97b-21947cfc7573">
            <name>cdi:hasIntendedDataType</name>
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.RepresentedVariable.cdi_hasIntendedDataType.lower" xmi:uuid="fc96b1d5-0caf-50dd-b13f-d6c82bdfddf0">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.RepresentedVariable.cdi_hasIntendedDataType.upper" xmi:uuid="ba096ff7-4334-5cc2-8cfe-b77ebcfc1b6b">
              <value>1</value>
            </upperValue>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.RepresentedVariable.cdi_hasIntendedDataType.comment" xmi:uuid="b9037b7c-23d4-5f42-a0f3-491b5286a984">
              <body>**CDIF**

Definition
==========

Intended physical datatype for variable values.

**Original (DDICDI)**

*Definition:* The data type intended to be used by this variable. Supports the optional use of an external controlled vocabulary.

`Specification item reference &lt;https://ddi-cdi.github.io/m2t-ng/DDI-CDI_1-1beta/field-level-documentation/DDICDILibrary/Classes/Conceptual/RepresentedVariable.html&gt;`__</body>
              <annotatedElement xmi:idref="cdif.RepresentedVariable.cdi_hasIntendedDataType"/>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.RepresentedVariable.cdi_simpleUnitOfMeasure" xmi:uuid="3c02631f-6c33-5a7b-a2b9-4220bc055ceb">
            <name>cdi:simpleUnitOfMeasure</name>
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.RepresentedVariable.cdi_simpleUnitOfMeasure.lower" xmi:uuid="bba68d08-e847-56c8-adbc-e9358b28455b">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.RepresentedVariable.cdi_simpleUnitOfMeasure.upper" xmi:uuid="f3b064b2-7e4f-50aa-96be-d5276196ede1">
              <value>1</value>
            </upperValue>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.RepresentedVariable.cdi_simpleUnitOfMeasure.comment" xmi:uuid="91415dc8-62f7-52ae-b6b7-ea7e69b34fb2">
              <body>**CDIF**

Definition
==========

Unit expressed as a simple string when no controlled-vocabulary entry is available or needed.

**Original (DDICDI)**

*Definition:* The unit in which the data values are measured (kg, pound, euro), expressed as a simple string, in cases where no additional information is available (in the legacy system) or needed (as in the case of broad agreement within the community of use [i.e., ISO country codes, currencies, etc. in SDMX])

`Specification item reference &lt;https://ddi-cdi.github.io/m2t-ng/DDI-CDI_1-1beta/field-level-documentation/DDICDILibrary/Classes/Conceptual/RepresentedVariable.html&gt;`__</body>
              <annotatedElement xmi:idref="cdif.RepresentedVariable.cdi_simpleUnitOfMeasure"/>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_describedUnitOfMeasure_CdifConceptOrTerm" xmi:uuid="f47cc7db-c1d7-56dd-a728-1a454b603825">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_describedUnitOfMeasure_CdifConceptOrTerm.lower" xmi:uuid="6a587a97-45d7-560a-8268-866f6edf6d87">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_describedUnitOfMeasure_CdifConceptOrTerm.upper" xmi:uuid="8f814870-9001-5282-8b57-2e1a5f04a579">
              <value>1</value>
            </upperValue>
            <association xmi:idref="assoc.RepresentedVariable_cdi_describedUnitOfMeasure_CdifConceptOrTerm"/>
            <type xmi:idref="cdif.CdifConceptOrTerm"/>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_describedUnitOfMeasure_CdifConceptOrTerm.comment" xmi:uuid="89f2c511-5623-51ca-82de-bb0199427d75">
              <body>**CDIF**

Definition
==========

one of: string, ``cdifConceptOrTerm`` ``@id`` reference.

**Original (DDICDI)**

*Definition:* The unit in which the data values are measured (kg, pound, euro), expressed as a value from a controlled system of entries (i.e., QDT). Supports the provision of an identifier for the entry in the authoritative source (a URI, etc.), and the specific vocabulary.

`Specification item reference &lt;https://ddi-cdi.github.io/m2t-ng/DDI-CDI_1-1beta/field-level-documentation/DDICDILibrary/Classes/Conceptual/RepresentedVariable.html&gt;`__</body>
              <annotatedElement xmi:idref="cdif.RepresentedVariable.RepresentedVariable_cdi_describedUnitOfMeasure_CdifConceptOrTerm"/>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_unitOfMeasureKind_CdifConceptOrTerm" xmi:uuid="2fb987ac-acad-5779-a6f9-46467f88b3b8">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_unitOfMeasureKind_CdifConceptOrTerm.lower" xmi:uuid="f5e8b107-4878-56ce-82ca-13b9b1411f62">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_unitOfMeasureKind_CdifConceptOrTerm.upper" xmi:uuid="05e0e406-8efa-56f7-9bd3-ede344748827">
              <value>1</value>
            </upperValue>
            <association xmi:idref="assoc.RepresentedVariable_cdi_unitOfMeasureKind_CdifConceptOrTerm"/>
            <type xmi:idref="cdif.CdifConceptOrTerm"/>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_unitOfMeasureKind_CdifConceptOrTerm.comment" xmi:uuid="76111a20-55dc-585f-947e-4166dfa06260">
              <body>**CDIF**

Definition
==========

Kind of unit (e.g., "temperature", "salinity"), allowing translation between equivalent units.

**Original (DDICDI)**

`Specification item reference &lt;https://ddi-cdi.github.io/m2t-ng/DDI-CDI_1-1beta/field-level-documentation/DDICDILibrary/Classes/Conceptual/RepresentedVariable.html&gt;`__</body>
              <annotatedElement xmi:idref="cdif.RepresentedVariable.RepresentedVariable_cdi_unitOfMeasureKind_CdifConceptOrTerm"/>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_measures_RepresentedVariable" xmi:uuid="935af5c1-aaf6-518d-86b9-bdc9dbeee40d">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_measures_RepresentedVariable.lower" xmi:uuid="0c197869-def3-5d61-9416-7d68331ae99f">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_measures_RepresentedVariable.upper" xmi:uuid="1dab43f7-e289-56fe-a5f2-c7ee45573ae7">
              <value>1</value>
            </upperValue>
            <association xmi:idref="assoc.RepresentedVariable_cdi_measures_RepresentedVariable"/>
            <type xmi:idref="cdif.RepresentedVariable"/>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_measures_RepresentedVariable.comment" xmi:uuid="b16789d0-9899-5ec2-808b-d60d50f8d32c">
              <body>**CDIF**

Definition
==========

inline object or ``@id`` reference to a ``cdif:RepresentedVariable``.

**Original (DDICDI)**

`Specification item reference &lt;https://ddi-cdi.github.io/m2t-ng/DDI-CDI_1-1beta/field-level-documentation/DDICDILibrary/Classes/Conceptual/RepresentedVariable.html&gt;`__</body>
              <annotatedElement xmi:idref="cdif.RepresentedVariable.RepresentedVariable_cdi_measures_RepresentedVariable"/>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_takesSubstantiveValuesFrom_SubstantiveValueDomain" xmi:uuid="7f9acb53-aca1-5804-ba14-4609a054f9d1">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_takesSubstantiveValuesFrom_SubstantiveValueDomain.lower" xmi:uuid="b3f684c2-7d9e-567c-8e39-c23c05a9e409">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_takesSubstantiveValuesFrom_SubstantiveValueDomain.upper" xmi:uuid="62e1bb2d-2233-5388-8b74-cd2df5542936">
              <value>1</value>
            </upperValue>
            <association xmi:idref="assoc.RepresentedVariable_cdi_takesSubstantiveValuesFrom_SubstantiveValueDomain"/>
            <type xmi:idref="cdi.SubstantiveValueDomain"/>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.RepresentedVariable.RepresentedVariable_cdi_takesSubstantiveValuesFrom_SubstantiveValueDomain.comment" xmi:uuid="33b7d5aa-05ba-550d-a139-a78df1b8fec7">
              <body>**CDIF**

