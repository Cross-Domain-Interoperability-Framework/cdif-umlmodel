            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.AttributeComponent.AttributeComponent_cdi_qualifies_DataStructureComponent.upper" xmi:uuid="967af166-a656-52e1-b1ec-552db675bc66">
              <value>*</value>
            </upperValue>
            <association xmi:idref="assoc.AttributeComponent_cdi_qualifies_DataStructureComponent"/>
            <type xmi:idref="cdif.DataStructureComponent"/>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.AttributeComponent.AttributeComponent_cdi_qualifies_DataStructureComponent.comment" xmi:uuid="38b87735-1040-54a1-b4f9-51b3a8ee1cf1">
              <body>**CDIF**

Definition
