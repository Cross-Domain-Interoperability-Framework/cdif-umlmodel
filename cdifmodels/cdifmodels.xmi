            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="assoc.Dataset_subjectOf_Dataset.ownedEnd.upper" xmi:uuid="27831cc2-8fb6-5d07-a0e9-1cefce7a092d">
              <value>*</value>
            </upperValue>
            <association xmi:idref="assoc.Dataset_subjectOf_Dataset"/>
            <type xmi:idref="cdif.Dataset"/>
          </ownedEnd>
          <memberEnd xmi:idref="assoc.Dataset_subjectOf_Dataset.ownedEnd"/>
          <memberEnd xmi:idref="cdif.Dataset.Dataset_subjectOf_Dataset"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Association" xmi:id="assoc.Dataset_subjectOf_CatalogRecord" xmi:uuid="41284935-9ee1-5b64-ae08-0f830433eb30">
          <name>Dataset_subjectOf_CatalogRecord</name>
          <ownedComment xmi:type="uml:Comment" xmi:id="assoc.Dataset_subjectOf_CatalogRecord.comment" xmi:uuid="fe0773da-1dca-593c-998e-e1f60fcaa0ee">
            <body>**CDIF**

Definition
==========

This property contains information about the metadata record itself, as opposed to the resource the record describes. See Uses of dcat:CatalogRecord and https://github.com/Cross-Domain-Interoperability-Framework/Discovery/issues/13 for discussion on how to make assertion about the metadata record distinct from statements about the described resource. Use the dcat:CatalogRecord as additionalType to distinguish this schema:Dataset from the schema:Dataset about a described external resource. see &lt;https://cross-domain-interoperability-framework.github.io/cdifbook/metadata/contentmodel.html#properties-for-metadata-management&gt;. Introduction of this is novel for schema.org implementations. | (required) conformance statement in the subjectOf/dcat:catalogRecord must include "dcterms:conformsTo" includes    "https://w3id.org/cdif/manifest/1.1"</body>
            <annotatedElement xmi:idref="assoc.Dataset_subjectOf_CatalogRecord"/>
          </ownedComment>
