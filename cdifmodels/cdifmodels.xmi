              <body>**CDIF**

Definition
==========

Enumerates the codes that can appear in the descriptor column, each paired (via ``cdif:isDefinedBy``) with the represented variable that the code names.</body>
              <annotatedElement xmi:idref="cdif.DescriptorVariable.DescriptorVariable_hasValuesFrom_DescriptorValueDomain"/>
            </ownedComment>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="cdif.DimensionComponent" xmi:uuid="7ee5b7a2-7af5-592e-8a89-ad64e2e00391">
