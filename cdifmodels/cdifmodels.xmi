          <supplier xmi:idref="cdi.CategoryStatistics"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Dependency" xmi:id="profiles.DataDescription.dep.cdi.SentinelValueDomain" xmi:uuid="32b42f2a-61a0-5511-8a54-cb2bda5c17fd">
