            <annotatedElement xmi:idref="cdif.IdentifierComponent"/>
          </ownedComment>
          <generalization xmi:type="uml:Generalization" xmi:id="cdif.IdentifierComponent.gen.DataStructureComponent" xmi:uuid="78da9e3b-ca3e-55dd-8060-e8728135c1c2">
            <general xmi:idref="cdif.DataStructureComponent"/>
          </generalization>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.IdentifierComponent.IdentifierComponent_isDefinedBy_RepresentedVariable" xmi:uuid="807a0fa0-3bc9-5a86-9548-951bbd2ddf6f">
