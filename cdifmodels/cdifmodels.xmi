              <value>1</value>
            </upperValue>
            <association xmi:idref="assoc.AttributeComponent_isDefinedBy_RepresentedVariable"/>
            <type xmi:idref="cdif.RepresentedVariable"/>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.AttributeComponent.AttributeComponent_isDefinedBy_RepresentedVariable.comment" xmi:uuid="14bbd97f-9213-5042-96dc-76720a7c8383">
              <body>**CDIF**

