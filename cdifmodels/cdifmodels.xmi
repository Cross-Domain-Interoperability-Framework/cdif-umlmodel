              <value>*</value>
            </upperValue>
            <association xmi:idref="assoc.DataDownload_cdif_hasPhysicalMapping"/>
            <type xmi:idref="schema.DataDownload"/>
          </ownedEnd>
          <memberEnd xmi:idref="assoc.DataDownload_cdif_hasPhysicalMapping.ownedEnd"/>
          <memberEnd xmi:idref="schema.DataDownload.DataDownload_cdif_hasPhysicalMapping"/>
        </packagedElement>
