              <annotatedElement xmi:idref="cdif.VariableValueComponent.VariableValueComponent_cdi_semantic_CdifConceptOrTerm"/>
            </ownedComment>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Association" xmi:id="assoc.Dataset_distribution_DataDownload" xmi:uuid="3d2e6b8e-67cc-55ad-92d5-5da9a38330f4">
          <name>Dataset_distribution_DataDownload</name>
          <ownedComment xmi:type="uml:Comment" xmi:id="assoc.Dataset_distribution_DataDownload.comment" xmi:uuid="0674f3b3-ab89-554d-afe6-a6866c5a5232">
            <body>**CDIF**

Definition
==========

specifies how to download the data in a specific format or access via a web API. This property describes where to get the data and in what format by using the schema:DataDownload type. If user must access data through a landing page, provide link to landing page in the 'url' property for the dataset, not a distribution contentUrl. | If the DataDownload type is application/zip (might need more general way to identify bundled packages of files), then the DataDownload must have hasPart properties that are schema:MediaObject instances describing the contained files. **Cardinality:** Optional</body>
            <annotatedElement xmi:idref="assoc.Dataset_distribution_DataDownload"/>
          </ownedComment>
          <ownedEnd xmi:type="uml:Property" xmi:id="assoc.Dataset_distribution_DataDownload.ownedEnd" xmi:uuid="71fa4d00-66eb-539e-bfe8-6eee73f92d50">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="assoc.Dataset_distribution_DataDownload.ownedEnd.lower" xmi:uuid="81fffb36-ef31-5519-8176-8c91d94852ba"/>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="assoc.Dataset_distribution_DataDownload.ownedEnd.upper" xmi:uuid="5161d465-f275-5b4f-b400-023b3640a9d5">
              <value>*</value>
            </upperValue>
            <association xmi:idref="assoc.Dataset_distribution_DataDownload"/>
            <type xmi:idref="cdif.Dataset"/>
          </ownedEnd>
          <memberEnd xmi:idref="assoc.Dataset_distribution_DataDownload.ownedEnd"/>
          <memberEnd xmi:idref="cdif.Dataset.Dataset_distribution_DataDownload"/>
        </packagedElement>
