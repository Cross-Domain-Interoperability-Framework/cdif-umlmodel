              <value>1</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.DimensionComponent.DimensionComponent_isDefinedBy_RepresentedVariable.upper" xmi:uuid="6906dca7-e1fb-5869-a293-4c12ee09f7c7">
              <value>1</value>
            </upperValue>
            <association xmi:idref="assoc.DimensionComponent_isDefinedBy_RepresentedVariable"/>
            <type xmi:idref="cdif.RepresentedVariable"/>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.DimensionComponent.DimensionComponent_isDefinedBy_RepresentedVariable.comment" xmi:uuid="f15bcd7b-99a4-5739-bec9-b15731ae992e">
              <body>**CDIF**

Definition
==========

``cdif:RepresentedVariable`` inline or ``@id`` reference. Logical variable that contains values for this component.</body>
              <annotatedElement xmi:idref="cdif.DimensionComponent.DimensionComponent_isDefinedBy_RepresentedVariable"/>
            </ownedComment>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="cdif.EnumerationDomain" xmi:uuid="acaeef4a-d8f1-5c8b-b080-ea91cb586cb4">
