              <value>1</value>
            </upperValue>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.Dataset.version.comment" xmi:uuid="c2644762-d1f9-5f7d-8fab-4ec89ec58ff4">
              <body>**CDIF**

Definition
==========

The version number or identifier for this dataset (text or numeric). The values should sort from oldest to newest using an alphanumeric sort on version strings</body>
              <annotatedElement xmi:idref="cdif.Dataset.version"/>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.Dataset.inLanguage" xmi:uuid="09ab3604-7aea-5cf2-84de-44b6bdb3ac4b">
