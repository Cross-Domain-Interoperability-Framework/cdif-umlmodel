          <ownedAttribute xmi:type="uml:Property" xmi:id="schema.DataDownload.DataDownload_cdif_coTypedAs_AbstractDataSet" xmi:uuid="93cce25f-573f-58f3-9546-040f1d1ef1f4">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="schema.DataDownload.DataDownload_cdif_coTypedAs_AbstractDataSet.lower" xmi:uuid="495fe9fd-c608-56bd-abf4-50f9fda5ea97">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="schema.DataDownload.DataDownload_cdif_coTypedAs_AbstractDataSet.upper" xmi:uuid="4dfe75bb-8973-52c8-be70-943ac6d641ab">
              <value>1</value>
            </upperValue>
            <association xmi:idref="assoc.DataDownload_cdif_coTypedAs_AbstractDataSet"/>
