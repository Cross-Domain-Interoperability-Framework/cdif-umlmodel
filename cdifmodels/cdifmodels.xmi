            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.UnitType.cdi_externalDefinition.upper" xmi:uuid="df3e3e5b-9a9f-5f09-9775-9a9dcfcd77e3">
