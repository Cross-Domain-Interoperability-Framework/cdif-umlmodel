              <body>**CDIF**

Definition
==========

Other identifiers for the dataset, as IRI references, literal strings, or structured identifiers using schema:PropertyValue.</body>
              <annotatedElement xmi:idref="cdif.Dataset.sameAs"/>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.Dataset.version" xmi:uuid="867cb4bf-7f51-5056-95a8-506a4f84f501">
