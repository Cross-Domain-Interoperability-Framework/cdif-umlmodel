            <name>encodingFormat</name>
            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="schema.MediaObject.encodingFormat.lower" xmi:uuid="e3057228-e76e-570f-aee1-13eee7e1fa65">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="schema.MediaObject.encodingFormat.upper" xmi:uuid="54f2a2d0-75c2-5bd0-8aca-c18a87e2c3fe">
