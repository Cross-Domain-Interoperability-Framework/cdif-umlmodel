            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="assoc.AgentInRole_contributor_Organization.ownedEnd.upper" xmi:uuid="ec8d1d48-6c4e-5cb3-acb7-2dac82ad1fcd">
