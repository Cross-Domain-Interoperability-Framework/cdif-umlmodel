            <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String"/>
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.RepresentedVariable.name.lower" xmi:uuid="60ad9ef1-3de6-5cb1-81fa-92f601fe18a4">
              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.RepresentedVariable.name.upper" xmi:uuid="360eee29-d4f5-584b-b6e3-fd25903de8a8">
              <value>*</value>
            </upperValue>
            <ownedComment xmi:type="uml:Comment" xmi:id="cdif.RepresentedVariable.name.comment" xmi:uuid="8ff658fd-031a-57f0-a413-5e6b3d9dedc8">
              <body>**CDIF**

Definition
==========

array of string</body>
              <annotatedElement xmi:idref="cdif.RepresentedVariable.name"/>
            </ownedComment>
          </ownedAttribute>
