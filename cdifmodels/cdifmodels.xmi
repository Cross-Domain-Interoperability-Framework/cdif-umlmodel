          <memberEnd xmi:idref="assoc.Dataset_additionalType_DefinedTerm.ownedEnd"/>
          <memberEnd xmi:idref="cdif.Dataset.Dataset_additionalType_DefinedTerm"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Association" xmi:id="assoc.Dataset_relatedLink_LinkRole" xmi:uuid="59eb896a-e5ac-5319-95da-bac1447fc389">
          <name>Dataset_relatedLink_LinkRole</name>
          <ownedComment xmi:type="uml:Comment" xmi:id="assoc.Dataset_relatedLink_LinkRole.comment" xmi:uuid="1a7932c4-65c9-5202-981e-5660595510b0">
            <body>**CDIF**

Definition
==========

links to related resources; linkRelationship specifies how the resource is related. Use schema.org LinkRole type for values, with a linkRelationship and target that documents the url and encoding format of the linked content.</body>
            <annotatedElement xmi:idref="assoc.Dataset_relatedLink_LinkRole"/>
          </ownedComment>
          <ownedEnd xmi:type="uml:Property" xmi:id="assoc.Dataset_relatedLink_LinkRole.ownedEnd" xmi:uuid="8dac4085-471a-584e-836c-4fb3e9cf5040">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="assoc.Dataset_relatedLink_LinkRole.ownedEnd.lower" xmi:uuid="b6d83206-b158-5618-9850-78074e625378"/>
