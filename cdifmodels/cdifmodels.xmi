            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="assoc.AdditionalProperty_unitCode_DefinedTerm.ownedEnd.upper" xmi:uuid="199b140d-c8df-57ca-8145-0087bc911637">
              <value>*</value>
            </upperValue>
            <association xmi:idref="assoc.AdditionalProperty_unitCode_DefinedTerm"/>
            <type xmi:idref="schema.AdditionalProperty"/>
          </ownedEnd>
          <memberEnd xmi:idref="assoc.AdditionalProperty_unitCode_DefinedTerm.ownedEnd"/>
          <memberEnd xmi:idref="schema.AdditionalProperty.AdditionalProperty_unitCode_DefinedTerm"/>
        </packagedElement>
