              <value>0</value>
            </lowerValue>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="skos.Concept.Concept_topConceptOf_ConceptScheme.upper" xmi:uuid="fdc12b02-483a-5e99-a1c8-cf1473022c6a">
              <value>*</value>
            </upperValue>
            <association xmi:idref="assoc.Concept_topConceptOf_ConceptScheme"/>
            <type xmi:idref="skos.ConceptScheme"/>
            <ownedComment xmi:type="uml:Comment" xmi:id="skos.Concept.Concept_topConceptOf_ConceptScheme.comment" xmi:uuid="9ffe9cf7-a244-5739-8033-da80a37f2607">
              <body>**CDIF**

Definition
==========

Scheme(s) for which this is a top concept.

**Original (SKOS)**

*Definition:* Relates a concept to the concept scheme that it is a top level concept of.

`Specification item reference &lt;http://www.w3.org/2004/02/skos/core#topConceptOf&gt;`__</body>
              <annotatedElement xmi:idref="skos.Concept.Concept_topConceptOf_ConceptScheme"/>
