              <annotatedElement xmi:idref="cdif.AttributeComponent.AttributeComponent_isDefinedBy_RepresentedVariable"/>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.AttributeComponent.AttributeComponent_cdi_qualifies_DataStructureComponent" xmi:uuid="b10e4fd5-7ba2-55d2-816c-8e87e2aac1d4">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.AttributeComponent.AttributeComponent_cdi_qualifies_DataStructureComponent.lower" xmi:uuid="b88e805b-fe2b-5479-b0f5-19275326b09b">
