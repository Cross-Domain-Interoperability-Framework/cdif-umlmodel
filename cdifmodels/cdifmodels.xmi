              <value>*</value>
            </upperValue>
            <association xmi:idref="assoc.MediaObject_size_QuantitativeValue"/>
            <type xmi:idref="schema.MediaObject"/>
          </ownedEnd>
          <memberEnd xmi:idref="assoc.MediaObject_size_QuantitativeValue.ownedEnd"/>
          <memberEnd xmi:idref="schema.MediaObject.MediaObject_size_QuantitativeValue"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Association" xmi:id="assoc.AgentInRole_roleName_DefinedTerm" xmi:uuid="f9b973e7-b358-560d-9958-43c6b3acfb76">
