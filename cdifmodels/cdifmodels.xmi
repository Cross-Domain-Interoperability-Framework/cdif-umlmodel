        <packagedElement xmi:type="uml:Association" xmi:id="assoc.Dataset_keywords_DefinedTerm" xmi:uuid="34b2b1c9-e08e-5b54-8623-b8a5d77ffc04">
          <name>Dataset_keywords_DefinedTerm</name>
          <ownedComment xmi:type="uml:Comment" xmi:id="assoc.Dataset_keywords_DefinedTerm.comment" xmi:uuid="5cfba658-f2ba-599c-ab5c-9e189f0d9751">
            <body>**CDIF**

Definition
==========

Keywords are an array of strings, an array of schema:DefinedTerms, or some combination of these. If you have information about a controlled vocabulary from which keywords come from, use schema:DefinedTerm to descibe that keyword. This allowed variability complicates parsing the metadata record; recommend using DefinedTerm for all keywords if any of them are from a known vocabulary, otherwise an array of strings.</body>
            <annotatedElement xmi:idref="assoc.Dataset_keywords_DefinedTerm"/>
          </ownedComment>
          <ownedEnd xmi:type="uml:Property" xmi:id="assoc.Dataset_keywords_DefinedTerm.ownedEnd" xmi:uuid="704337f4-54b4-5631-b059-090e3576ce07">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="assoc.Dataset_keywords_DefinedTerm.ownedEnd.lower" xmi:uuid="52973b29-1a5a-5ff9-a26f-70adaacb0e63"/>
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="assoc.Dataset_keywords_DefinedTerm.ownedEnd.upper" xmi:uuid="f1c147f9-7ef8-5621-b2f1-62ae0cf284b6">
              <value>*</value>
            </upperValue>
            <association xmi:idref="assoc.Dataset_keywords_DefinedTerm"/>
            <type xmi:idref="cdif.Dataset"/>
          </ownedEnd>
          <memberEnd xmi:idref="assoc.Dataset_keywords_DefinedTerm.ownedEnd"/>
          <memberEnd xmi:idref="cdif.Dataset.Dataset_keywords_DefinedTerm"/>
        </packagedElement>
