      <body>Generated by bblock_to_xmi.py from building block 'Identifier' (schemaorgProperties/identifier).</body>
      <annotatedElement xmi:idref="model.CDIFIdentifier"/>
    </ownedComment>
    <packagedElement xmi:type="uml:Package" xmi:id="XMLSchemaDataTypes" xmi:uuid="0beb6c1c-e995-5601-a3dd-c0ff6426dfe1">
      <name>XMLSchemaDataTypes</name>
      <URI>https://w3id.org/cdif/XMLSchemaDataTypes/xmi/</URI>
      <packagedElement xmi:type="uml:DataType" xmi:id="XMLSchemaDataTypes.XsdAnyUri" xmi:uuid="2b3f90f5-1283-5fda-9661-7150fbd95ce0">
        <name>XsdAnyUri</name>
        <ownedComment xmi:type="uml:Comment" xmi:id="XMLSchemaDataTypes.XsdAnyUri.comment" xmi:uuid="04ec2457-3fbf-5e99-957a-c5c4e09eff14">
          <body>**CDIF**

Definition
==========

XML Schema primitive datatype (XsdAnyUri).</body>
          <annotatedElement xmi:idref="XMLSchemaDataTypes.XsdAnyUri"/>
