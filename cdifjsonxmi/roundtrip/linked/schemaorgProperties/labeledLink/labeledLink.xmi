    <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.schemaorgProperties.labeledLink.model.comment" xmi:uuid="b939cce0-946b-5093-bf84-4ecc58b36c60">
      <body>Building block cdif.bbr.metadata.schemaorgProperties.labeledLink ('Labeled Link'), generated by bblock_to_xmi.py --linked.</body>
      <annotatedElement xmi:idref="cdif.bbr.metadata.schemaorgProperties.labeledLink.model"/>
