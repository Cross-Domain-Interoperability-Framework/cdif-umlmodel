          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.schemaorgProperties.labeledLink.ObjectReferenceOrString.string.upper" xmi:uuid="6d54de03-337d-5605-ac9a-b7544ac8554f">
