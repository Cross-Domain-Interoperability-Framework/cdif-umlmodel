          </upperValue>
          <association xmi:idref="cdif.bbr.metadata.schemaorgProperties.action.assoc.Action_query-input_ActionPropertyValueSpecification"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.schemaorgProperties.action.Action.query-input.comment" xmi:uuid="fdfe6b49-ac7a-569c-896d-fa6442d3764c">
            <body>**CDIF**

Definition
==========

set of explanations of the parameters in the URL template for the target.
:inlineOrByReference: ``inline``
:itemsDescription: "Query input parameter for a web API action, typed as schema:PropertyValueSpecification."</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.schemaorgProperties.action.Action.query-input"/>
          </ownedComment>
        </ownedAttribute>
