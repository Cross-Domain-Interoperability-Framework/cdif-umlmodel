          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.schemaorgProperties.action.ActionEntryPoint.description.upper" xmi:uuid="17001c75-d3ca-51d7-8ac3-e8be959a703e">
