          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.schemaorgProperties.spatialExtent.GeoCoordinatesOrGeoShapeOrGeoShape2.geoShape.upper" xmi:uuid="c3219eb7-e7b3-505c-a1e5-f3b274596f80">
