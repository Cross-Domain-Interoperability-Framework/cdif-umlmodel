            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.schemaorgProperties.definedTerm.DefinedTerm.termCode.upper" xmi:uuid="c7b2e33e-0dd5-537e-9556-de031be4c300">
