          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.schemaorgProperties.definedTerm.DefinedTerm.identifier.upper" xmi:uuid="bc3d1ebd-c2eb-59af-bbff-8cb6bda42d44">
            <value>1</value>
