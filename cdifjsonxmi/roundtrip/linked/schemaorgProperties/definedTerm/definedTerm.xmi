        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.schemaorgProperties.definedTerm.DefinedTerm.inDefinedTermSet" xmi:uuid="da5d49c4-1a20-56a4-8766-9d87248ff0b6">
          <name>inDefinedTermSet</name>
