          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.schemaorgProperties.dataDownload.DataDownload.spdx_checksum.comment" xmi:uuid="2771d01a-3193-56ea-bf52-045015952c34">
            <body>**CDIF**

Definition
==========

A string value calculated from the content of the resource representation, used to test if content has been modified. The checksum is a property of a particular distribution/DataDownload.
:jsonName: "spdx:checksum"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.schemaorgProperties.dataDownload.DataDownload.spdx_checksum"/>
