          <body>**CDIF**

Definition
==========

schema to document file-based access to a resoruce via URL, based on schema.org/DataDownload
:rdfType: ``schema:DataDownload``
:typeDescription: "implement as array because extensions might need to add additional types"
:constraint: {"if": {"not": {"type": "object", "required": ["@type"], "properties": {"@type": {"type": "array", "contains": {"const": "schema:Collection"}}}}}, "then": {"required": ["schema:contentUrl"]}, "else": {"required": ["schema:hasPart"]}}</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.schemaorgProperties.dataDownload.DataDownload"/>
        </ownedComment>
        <generalization xmi:type="uml:Generalization" xmi:id="cdif.bbr.metadata.schemaorgProperties.dataDownload.DataDownload.generalization" xmi:uuid="99264530-7e9a-5f4b-a852-73ba3dc78826">
