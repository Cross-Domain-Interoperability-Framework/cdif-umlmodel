            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.schemaorgProperties.dataDownload.DataDownload.dcterms_conformsTo.upper" xmi:uuid="422799ae-4fcb-593b-8b95-a81487f11759">
            <value>*</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.schemaorgProperties.dataDownload.DataDownload.dcterms_conformsTo.comment" xmi:uuid="8452a8aa-aeaf-5007-b2fb-4c10d4ea8f84">
            <body>**CDIF**

Definition
==========

An identifier for a standard or specification that the distribution conforms to. Recommended to enable machine-actionable data access.
:minItems: 1
:idRefDescription: "uri for specification that this distribution conforms to"
:jsonName: "dcterms:conformsTo"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.schemaorgProperties.dataDownload.DataDownload.dcterms_conformsTo"/>
          </ownedComment>
