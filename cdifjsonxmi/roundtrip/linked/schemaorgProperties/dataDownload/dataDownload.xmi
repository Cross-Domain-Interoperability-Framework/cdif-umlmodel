          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.schemaorgProperties.dataDownload.DataDownload.spdx_checksum.upper" xmi:uuid="38e2a933-ab45-53de-82ff-2a69bf1883c3">
