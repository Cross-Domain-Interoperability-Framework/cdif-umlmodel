    <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.schemaorgProperties.webAPI.model.comment" xmi:uuid="bd2db825-73d2-5b01-af31-d3de482ac55b">
      <body>Building block cdif.bbr.metadata.schemaorgProperties.webAPI ('WebAPI properties'), generated by bblock_to_xmi.py --linked.</body>
