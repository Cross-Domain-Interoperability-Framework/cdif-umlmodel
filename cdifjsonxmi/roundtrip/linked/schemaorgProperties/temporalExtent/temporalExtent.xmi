            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.schemaorgProperties.temporalExtent.TemporalExtent.properInterval.upper" xmi:uuid="cb20fc64-7063-5c2f-83ef-9a137d692565">
            <value>1</value>
          </upperValue>
          <association xmi:idref="cdif.bbr.metadata.schemaorgProperties.temporalExtent.assoc.TemporalExtent_properInterval_TemporalExtentProperInterval"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.schemaorgProperties.temporalExtent.TemporalExtent.properInterval.comment" xmi:uuid="c276b8da-0a84-514e-936e-2a6f0b387bf3">
            <body>**CDIF**

Definition
==========

a w3c time proper interval with bounds that are named time ordinal eras with identifier, e.g. geologic age. This is a SOSO schema.org extension
:inlineOrByReference: ``inline``</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.schemaorgProperties.temporalExtent.TemporalExtent.properInterval"/>
          </ownedComment>
        </ownedAttribute>
