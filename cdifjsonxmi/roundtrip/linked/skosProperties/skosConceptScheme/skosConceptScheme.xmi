            <value>1</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.skosProperties.skosConceptScheme.ConceptScheme.prefLabel.upper" xmi:uuid="8363c745-9ff6-519e-958e-1d78f0d5e371">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.skosProperties.skosConceptScheme.ConceptScheme.prefLabel.comment" xmi:uuid="3063930c-4157-53c3-a0a0-0a9d10091f98">
            <body>**CDIF**

Definition
==========

Preferred lexical label for the concept scheme. A single string, a single language-tagged value, or an array of language-tagged values. Each language should appear at most once.</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.skosProperties.skosConceptScheme.ConceptScheme.prefLabel"/>
          </ownedComment>
        </ownedAttribute>
