            <value>1</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.skosProperties.skosConcept.Concept.prefLabel.upper" xmi:uuid="c7f36a0d-35f8-583b-846c-b363b4e3c9a7">
            <value>1</value>
