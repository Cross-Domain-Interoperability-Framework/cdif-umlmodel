          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.xasProperties.xasCore.XasCore.measurementTechnique.lower" xmi:uuid="b80f49ed-48ae-5f25-b229-264f6a323310">
            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.xasProperties.xasCore.XasCore.measurementTechnique.upper" xmi:uuid="feda1571-7f68-5784-bf27-56e9d021301e">
            <value>*</value>
          </upperValue>
          <association xmi:idref="cdif.bbr.metadata.xasProperties.xasCore.assoc.XasCore_measurementTechnique_DefinedTerm"/>
