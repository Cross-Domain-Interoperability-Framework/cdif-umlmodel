<xmi:XMI xmi:version="2.5.1" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101">
  <uml:Model xmi:id="cdif.bbr.metadata.xasProperties.xasFacility.model" xmi:uuid="80063234-3e2b-5467-b7f3-2f55e64198ec">
    <name>xasFacility</name>
