            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.xasProperties.xasFacility.XasFacility.additionalProperty.upper" xmi:uuid="08d93cc8-6cd2-56c9-8a8e-85afe04b2009">
            <value>*</value>
          </upperValue>
          <association xmi:idref="cdif.bbr.metadata.xasProperties.xasFacility.assoc.XasFacility_additionalProperty_AdditionalProperty"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.xasProperties.xasFacility.XasFacility.additionalProperty.comment" xmi:uuid="ae8b816b-66ae-5472-8eb5-bcc8f21d341e">
            <body>**CDIF**

Definition
==========

Facility-scope properties that are not places, e.g. storage-ring energy or current. Not offered by the core block, which describes a location rather than an operating machine.
:inlineOrByReference: ``inline``</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.xasProperties.xasFacility.XasFacility.additionalProperty"/>
          </ownedComment>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="cdif.bbr.metadata.xasProperties.xasFacility.assoc.XasFacility_additionalProperty_AdditionalProperty" xmi:uuid="837d6145-f0cb-5aa8-b971-05a4676d9191">
