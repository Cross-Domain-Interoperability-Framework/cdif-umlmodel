      <packagedElement xmi:type="uml:DataType" xmi:id="common.IdReference" xmi:uuid="8706b14e-5b51-5aeb-aebf-f3e363919845">
        <name>IdReference</name>
        <ownedComment xmi:type="uml:Comment" xmi:id="common.IdReference.comment" xmi:uuid="2c134b3a-625b-5364-86f7-c2757d97e486">
          <body>**CDIF**

Definition
==========

A reference to a node defined elsewhere. JSON-LD encoding: an object {"@id": string} with no other keys.</body>
          <annotatedElement xmi:idref="common.IdReference"/>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="common.IriReference" xmi:uuid="504c91fe-8377-5649-9719-308c129ebfb1">
