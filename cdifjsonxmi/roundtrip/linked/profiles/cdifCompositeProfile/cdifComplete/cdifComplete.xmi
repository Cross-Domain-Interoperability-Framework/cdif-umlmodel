      <packagedElement xmi:type="uml:Class" xmi:id="cdif.bbr.metadata.profiles.cdifCompositeProfile.cdifComplete.Complete" xmi:uuid="b9082cce-ab44-5029-b709-76284c0d2410">
        <name>Complete</name>
        <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.profiles.cdifCompositeProfile.cdifComplete.Complete.comment" xmi:uuid="e0f45b37-cb52-58ee-98ef-4a2daea9a447">
          <body>**CDIF**

Definition
==========

CDIF complete profile combining core metadata with discovery properties, data description, archive distribution, and provenance extensions.
:title: "CDIF complete metadata schema"
:prefix: ``schema``
:contextSchema: {"type": "object", "description": "Additional JSON-LD namespace prefixes for complete profile.", "properties": {"geosparql": {"const": "http://www.opengis.net/ont/geosparql#"}, "dqv": {"const": "http://www.w3.org/ns/dqv#"}, "cdi": {"const": "http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/"}}}
:constraint: {"properties": {"schema:subjectOf": {"properties": {"dcterms:conformsTo": {"allOf": [{"contains": {"type": "object", "required": ["@id"], "additionalProperties": false, "properties": {"@id": {"const": "https://w3id.org/cdif/data_description/1.1"}}}}, {"contains": {"type": "object", "required": ["@id"], "additionalProperties": false, "properties": {"@id": {"const": "https://w3id.org/cdif/manifest/1.1"}}}}, {"contains": {"type": "object", "required": ["@id"], "additionalProperties": false, "properties": {"@id": {"const": "https://w3id.org/cdif/provenance/1.1"}}}}]}}}}}
:noId:
:extends:
:ownDescription: "cdifComplete-specific additions. Measurement technique, spatial / temporal coverage, and quality measurement come through from cdifDiscovery via the allOf composition above; this branch only adds the multi-spec conformance declarations that mark a record as cdifComplete."</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.profiles.cdifCompositeProfile.cdifComplete.Complete"/>
        </ownedComment>
