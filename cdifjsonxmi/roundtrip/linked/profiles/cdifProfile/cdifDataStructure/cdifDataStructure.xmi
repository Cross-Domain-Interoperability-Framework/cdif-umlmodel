          <type xmi:idref="cdif.bbr.metadata.profiles.cdifProfile.cdifDataStructure.LongDataStructureDataStructureComponentChoice"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifDataStructure.LongDataStructure.has_DataStructureComponent.lower" xmi:uuid="6a342ef0-5860-5ce2-8616-32bcbd2f4e5a">
            <value>1</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifDataStructure.LongDataStructure.has_DataStructureComponent.upper" xmi:uuid="c759f172-c028-5449-a8ed-6be0e57c83dd">
            <value>*</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifDataStructure.LongDataStructure.has_DataStructureComponent.comment" xmi:uuid="35e7a8c9-bf8e-51a2-a228-7c30cb5808e1">
            <body>**CDIF**

Definition
==========

A LongDataStructure must include exactly one IdentifierComponent, exactly one VariableDescriptorComponent, exactly one VariableValueComponent, plus zero or more AttributeComponents.
:arrayKeywords: {"allOf": [{"contains": {"$ref": "bb:cdifDataType/cdifDataStructureComponent/schema.yaml#/$defs/IdentifierComponent"}, "minContains": 1, "maxContains": 1}, {"contains": {"$ref": "bb:cdifDataType/cdifDataStructureComponent/schema.yaml#/$defs/VariableDescriptorComponent"}, "minContains": 1, "maxContains": 1}, {"contains": {"$ref": "bb:cdifDataType/cdifDataStructureComponent/schema.yaml#/$defs/VariableValueComponent"}, "minContains": 1, "maxContains": 1}]}
:minItems: 3
:orReference: ["value", "objectReference"]</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.profiles.cdifProfile.cdifDataStructure.LongDataStructure.has_DataStructureComponent"/>
          </ownedComment>
        </ownedAttribute>
