        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.conditionsOfAccess" xmi:uuid="9ddb456a-912f-5f83-8541-3b8e76b4d7b4">
          <name>conditionsOfAccess</name>
