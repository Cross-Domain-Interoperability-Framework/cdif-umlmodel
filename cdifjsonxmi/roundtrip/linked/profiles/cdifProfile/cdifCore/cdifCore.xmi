          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.description.comment" xmi:uuid="4d54916f-fda2-56f1-aeab-7fd191b1363d">
            <body>**CDIF**

Definition
==========

A short summary describing a dataset. This text will be indexed by search applications, so the more information here, the better.</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.description"/>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.identifier" xmi:uuid="7e9401e7-8daa-5544-b18f-d5607bc3ecdb">
          <name>identifier</name>
          <type href="../../../schemaorgProperties/identifier/identifier.xmi#cdif.bbr.metadata.schemaorgProperties.identifier.Identifier"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.identifier.lower" xmi:uuid="1d72d7a6-860c-5c09-aed0-2e5b71b3e808">
            <value>1</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.identifier.upper" xmi:uuid="8ab779e0-bd72-5de3-93fd-d79294e8e41a">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.identifier.comment" xmi:uuid="20a2d39d-291c-5015-bcc5-c67ef502524a">
            <body>**CDIF**

Definition
==========

The primary identifier for the dataset; other identifiers should be listed in the sameAs field. Schema.org has three ways of encoding identifiers-- a text description, a URL, or by using the schema:PropertyValue field. The Science on Schema.org guidance strongly recommends using the PropertyValue approach. see https://github.com/ESIPFed/science-on-schema.org   .... Dataset.md#identifier.  Ideally, for any given data provided they would provide identifiers either all as strings or all as identifier_type.
:alsoAcceptsString:</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.identifier"/>
          </ownedComment>
        </ownedAttribute>
