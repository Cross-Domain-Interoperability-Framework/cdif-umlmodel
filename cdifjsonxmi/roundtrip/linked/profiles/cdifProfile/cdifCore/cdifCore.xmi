          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.name.lower" xmi:uuid="e7e261b3-c4bd-5258-b58a-f6daaa396786">
            <value>1</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.name.upper" xmi:uuid="70ea7168-d06b-5e31-9d2f-83650ffcb515">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.name.comment" xmi:uuid="487bb1f7-3908-5c75-a8ff-2422830fdbce">
            <body>**CDIF**

Definition
==========

A descriptive name of a dataset (e.g., 'Snow depth in Northern Hemisphere'). The name should uniquely identify the described resource for human use, in the scope of the metadata catalog containing this metadata record.</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.name"/>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.description" xmi:uuid="ccd90c0e-6362-5996-bf7a-24ec421e545e">
