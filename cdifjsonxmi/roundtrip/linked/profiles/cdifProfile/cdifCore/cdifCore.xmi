          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.description.lower" xmi:uuid="d6b1de77-ec5d-5a12-b815-646a2f168476">
            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.description.upper" xmi:uuid="66eaa115-3ee2-5cd5-8981-1e3beaac77d6">
            <value>1</value>
