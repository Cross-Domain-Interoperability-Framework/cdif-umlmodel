      <body>Building block cdif.bbr.metadata.profiles.cdifProfile.cdifCore ('CDIF Core metadata'), generated by bblock_to_xmi.py --linked.</body>
      <annotatedElement xmi:idref="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.model"/>
    </ownedComment>
    <packagedElement xmi:type="uml:Package" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore" xmi:uuid="7224f2a5-ff86-5237-a1a7-32204ae39e08">
      <name>cdifCore</name>
      <URI>https://w3id.org/cdif/bbr/metadata/profiles/cdifProfile/cdifCore</URI>
      <packagedElement xmi:type="uml:Class" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core" xmi:uuid="3f9ee39d-fb58-5cb6-b1ef-874d4783540e">
        <name>Core</name>
        <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.comment" xmi:uuid="3f5d5f39-096d-5046-90ac-536d03ee850d">
          <body>**CDIF**

Definition
==========

Building block specifies core properties for CDIF schema.org metadata record, applicable to any resource type.
:title: "Core properties for CDIF metadata schema, with schema: prefixes"
:idRequired:
:idDescription: "The URI for the resource should be the @id value for the root of the JSON instance document tree. Must be an IRI (e.g. https://doi.org/..., urn:..., or a relative URI like #localid). Note that this identifier can be interpreted to identify the resource that is the subject of this metadata record, or the JSON-LD object that is the digital object containing the metadata information."
:rdfType: ``schema:Dataset``
:typeDescription: "a schema.org Class that specifies the expected information content for the metadata record. The array must include at least one schema.org type value. Default is schema:Dataset."
:allowedTypes: ``schema:CreativeWork | schema:SoftwareApplication | schema:SoftwareSourceCode | schema:Product | schema:WebAPI | schema:Dataset | schema:DigitalDocument | schema:Collection | schema:ImageObject | schema:DataCatalog | schema:DefinedTermSet | schema:MediaObject``
:typeDefault: ``schema:Dataset``
:contextSchema: {"type": "object", "description": "JSON-LD context declaring namespace prefixes used in the metadata record.", "properties": {"schema": {"const": "http://schema.org/"}, "dcterms": {"const": "http://purl.org/dc/terms/"}, "spdx": {"const": "http://spdx.org/rdf/terms#"}, "dcat": {"const": "http://www.w3.org/ns/dcat#"}, "prov": {"const": "http://www.w3.org/ns/prov#"}}, "required": ["schema", "dcterms", "dcat", "prov"]}
:contextRequired:
:constraint: {"properties": {"schema:subjectOf": {"properties": {"dcterms:conformsTo": {"contains": {"type": "object", "required": ["@id"], "additionalProperties": false, "properties": {"@id": {"const": "https://w3id.org/cdif/core/1.1"}}}}}}}}
:constraint: {"description": "a bundle distribution with no schema:contentUrl obliges the dataset to publish a landing page in schema:url, so that the record still states a way to reach the data", "if": {"required": ["schema:distribution"], "properties": {"schema:distribution": {"type": "array", "contains": {"type": "object", "required": ["@type"], "properties": {"@type": {"type": "array", "contains": {"const": "schema:Collection"}}}, "not": {"required": ["schema:contentUrl"]}}}}}, "then": {"required": ["schema:url"]}}
:choiceConstraints:
- ``schema:license | schema:conditionsOfAccess``
- ``schema:url | schema:distribution``</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core"/>
        </ownedComment>
        <generalization xmi:type="uml:Generalization" xmi:id="cdif.bbr.metadata.profiles.cdifProfile.cdifCore.Core.generalization" xmi:uuid="b7c995d8-eb33-5fec-9018-ac7aa9d1b8b2">
          <general href="../../../cdifSharedTypes.xmi#cdif.shared.Dataset"/>
        </generalization>
