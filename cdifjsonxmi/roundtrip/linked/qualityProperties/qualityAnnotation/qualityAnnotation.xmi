          <type href="../../cdifCommonTypes.xmi#common.IdReference"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.qualityProperties.qualityAnnotation.QualityAnnotation.oa_hasTarget.lower" xmi:uuid="a09d9525-96d7-5fcf-88fd-a8bccbeb3452">
            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.qualityProperties.qualityAnnotation.QualityAnnotation.oa_hasTarget.upper" xmi:uuid="793a1fd0-a33f-584e-be73-e86c6edb5484">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.qualityProperties.qualityAnnotation.QualityAnnotation.oa_hasTarget.comment" xmi:uuid="9a52f01f-1106-5406-acb8-950288e3ec57">
            <body>**CDIF**

Definition
==========

the resource the annotation is about; if omitted, the annotation is about the resource that carries it (e.g. the Dataset)
:idRefDescription: "a resolvable reference to the annotated resource"
:jsonName: "oa:hasTarget"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.qualityProperties.qualityAnnotation.QualityAnnotation.oa_hasTarget"/>
          </ownedComment>
        </ownedAttribute>
