            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.bioschemasProperties.cdifBioschemasProperties.BioschemasProperties.executesLabProtocol.upper" xmi:uuid="43f5fed8-43a2-5e47-96fe-1a12555c1406">
