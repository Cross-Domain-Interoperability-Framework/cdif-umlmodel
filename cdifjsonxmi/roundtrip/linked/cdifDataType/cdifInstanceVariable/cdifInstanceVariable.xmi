    <name>cdifInstanceVariable</name>
    <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.model.comment" xmi:uuid="029784a1-c27a-52ca-a6e7-519ae2c1b92d">
      <body>Building block cdif.bbr.metadata.cdifDataType.cdifInstanceVariable ('CDIF Instance Variable'), generated by bblock_to_xmi.py --linked.</body>
      <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.model"/>
    </ownedComment>
    <packagedElement xmi:type="uml:Package" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable" xmi:uuid="167c0241-140c-5961-adbe-25969e9b5288">
      <name>cdifInstanceVariable</name>
      <URI>https://w3id.org/cdif/bbr/metadata/cdifDataType/cdifInstanceVariable</URI>
      <packagedElement xmi:type="uml:Class" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable" xmi:uuid="6ac4ed47-7975-5748-b693-7c83ed45b649">
        <name>InstanceVariable</name>
        <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.comment" xmi:uuid="fd70ea0b-250b-5ebe-a2f2-c83303473884">
          <body>**CDIF**

Definition
==========


:title: "CDIF Instance Variable"
:prefix: ``cdif``
:typeSchema: {"type": "array", "description": "Must include both schema:PropertyValue and cdi:InstanceVariable. Additional types may be included.", "items": {"type": "string"}, "contains": {"const": "cdi:InstanceVariable"}}
:constraint: {"$ref": "bb:schemaorgProperties/variableMeasured/schema.yaml"}
:constraint: {"if": {"required": ["cdif:isDefinedBy_RepresentedVariable"]}, "then": {"properties": {"cdi:takesSubstantiveValuesFrom": false, "cdi:takesSentinelValuesFrom": false, "cdif:hasIntendedDataType": false, "cdif:describedUnitOfMeasure": false, "cdif:unitOfMeasureKind": false, "cdi:measures": false, "cdif:externalDefinition": false, "cdif:uses_Concept": false, "cdif:definition": false}, "description": "When cdif:isDefinedBy_RepresentedVariable is present, the represented-variable-level properties live on that RepresentedVariable and may not be declared inline on the InstanceVariable."}}
:noId:</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable"/>
        </ownedComment>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.physicalDataType" xmi:uuid="2986d3c2-70ba-5e29-a2d6-2e386a9708c8">
          <name>physicalDataType</name>
