          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.source" xmi:uuid="b9b95467-a74c-5fa4-a562-77525769e229">
          <name>source</name>
          <type href="../../cdifCommonTypes.xmi#common.IriReference"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.source.lower" xmi:uuid="ef060bd6-d94a-59e6-b7c8-1f3158be96f7">
            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.source.upper" xmi:uuid="7079eed4-4da3-5b79-ad5f-59c0c2a55ed0">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.source.comment" xmi:uuid="bff81040-3194-529a-936e-a0a5758435f6">
