        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.isDescribedBy_StatisticsCollection" xmi:uuid="5f0d8cb0-ecac-58e8-9e03-baa23bf4a662">
          <name>isDescribedBy_StatisticsCollection</name>
          <type href="../cdifStatistics/cdifStatistics.xmi#cdif.bbr.metadata.cdifDataType.cdifStatistics.StatisticsCollection"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.isDescribedBy_StatisticsCollection.lower" xmi:uuid="dacee325-c054-5ce0-8c84-fa4f779c1f35">
            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.isDescribedBy_StatisticsCollection.upper" xmi:uuid="3debf33f-9bda-508c-bd8d-097049188ec9">
            <value>1</value>
          </upperValue>
          <association xmi:idref="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.assoc.InstanceVariable_isDescribedBy_StatisticsCollection_StatisticsCollection"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.isDescribedBy_StatisticsCollection.comment" xmi:uuid="bc1d4a83-c082-58db-9e31-b3ee2dd949db">
            <body>**CDIF**

Definition
==========

The StatisticsCollection holding summary / category statistics for this InstanceVariable (direct JSON mapping of the DDI-CDI `InstanceVariable.isDescribedBy → StatisticsCollection` association). cdif: namespaced and target-suffixed because the DDI-CDI isDescribedBy association is polymorphic. This is the canonical CDIF path for **per-variable** statistics; dataset-scope aggregates (row count etc.) go under `Dataset.cdif:statistics` instead.
:inlineOrByReference: ``inline``
:orReference: ["value", "idReference"]
:schemaRef: "cdifDataType/cdifStatistics#/$defs/StatisticsCollection"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.isDescribedBy_StatisticsCollection"/>
          </ownedComment>
        </ownedAttribute>
