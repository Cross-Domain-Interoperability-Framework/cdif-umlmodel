Immutable characteristic of the variable such as geographic designator, weight, temporal designation, etc. (InstanceVariable.function).</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.function"/>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.platformType" xmi:uuid="975a5f06-95e4-5d08-8b10-8d69f24420e0">
          <name>platformType</name>
          <type href="../cdifConceptOrTermOrString/cdifConceptOrTermOrString.xmi#cdif.bbr.metadata.cdifDataType.cdifConceptOrTermOrString.ConceptOrTermOrString"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.platformType.lower" xmi:uuid="228dc673-2aac-5ad4-9718-6cab4e57f3b5">
            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.platformType.upper" xmi:uuid="6725de8c-1508-5b4c-bf21-374d577de0e4">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifInstanceVariable.InstanceVariable.platformType.comment" xmi:uuid="a34a2104-a651-5112-9bcf-8cab333a23d0">
            <body>**CDIF**

