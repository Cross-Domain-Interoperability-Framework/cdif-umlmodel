          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_definition.comment" xmi:uuid="b5420115-42ee-57f8-97df-ed6a30354a10">
            <body>**CDIF**

Definition
==========

Natural language statement conveying the meaning of a concept, differentiating it from other concepts. Supports the use of multiple languages and structured text. 'externalDefinition' can't be used if 'definition' is used.
:jsonName: "cdif:definition"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_definition"/>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_displayLabel" xmi:uuid="8bba1b66-d9f0-5e85-b9ad-c162d2c185d0">
