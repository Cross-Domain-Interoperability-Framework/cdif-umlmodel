          <name>cdif_unitOfMeasureKind</name>
          <type href="../cdifConceptOrTermOrString/cdifConceptOrTermOrString.xmi#cdif.bbr.metadata.cdifDataType.cdifConceptOrTermOrString.ConceptOrTermOrString"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_unitOfMeasureKind.lower" xmi:uuid="7e9067cf-0f6e-5c30-ac9f-6bfb0fead64b">
            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_unitOfMeasureKind.upper" xmi:uuid="c3bd63ff-8c17-5e6c-a48d-eab6ba7f1a7c">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_unitOfMeasureKind.comment" xmi:uuid="cfea4677-7759-5158-914f-3a3f7c4fc805">
            <body>**CDIF**

Definition
==========

Kind of unit of measure, so that it may be prone to translation to equivalent UOMs. Example values include "acceleration," "temperature," "salinity", etc. This description exists at the conceptual level, indicating a limitation on the type of representations which may be used for the variable as it is made more concrete.
:jsonName: "cdif:unitOfMeasureKind"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_unitOfMeasureKind"/>
          </ownedComment>
        </ownedAttribute>
