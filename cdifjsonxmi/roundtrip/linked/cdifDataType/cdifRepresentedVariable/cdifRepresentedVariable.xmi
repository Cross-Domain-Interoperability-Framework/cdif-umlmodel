            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_definition.upper" xmi:uuid="aa7d8494-85be-5212-9a7b-7cfe346cd0bf">
