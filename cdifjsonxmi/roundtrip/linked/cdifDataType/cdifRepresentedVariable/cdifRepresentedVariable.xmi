          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_displayLabel.upper" xmi:uuid="107f4f4a-3c40-5ba4-abf3-fb3397371672">
            <value>*</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_displayLabel.comment" xmi:uuid="f087ee19-cb68-565d-a411-f590eb2cf377">
            <body>**CDIF**

Definition
==========

A human-readable display label for the object. Supports the use of multiple languages. Repeat for labels with different content, for example, labels with differing length limitations.
:minItems: 1
:jsonName: "cdif:displayLabel"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_displayLabel"/>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_externalDefinition" xmi:uuid="7815c2dd-3a0e-541b-b3b2-5cf9a6bb6310">
