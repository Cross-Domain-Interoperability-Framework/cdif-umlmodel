          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_name.comment" xmi:uuid="4fd460fe-d248-5522-abf1-adbce07bdcb9">
            <body>**CDIF**

Definition
==========

Human understandable name (linguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage.
:jsonName: "cdif:name"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_name"/>
