          <type href="../../schemaorgProperties/labeledLink/labeledLink.xmi#cdif.bbr.metadata.schemaorgProperties.labeledLink.LabeledLink"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_externalDefinition.lower" xmi:uuid="c28e7496-88a1-511e-920e-9985ceeb6a68">
            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_externalDefinition.upper" xmi:uuid="cc678ae2-74f1-5e14-9c14-5f8597b0f55e">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_externalDefinition.comment" xmi:uuid="860ad511-a7d1-50cd-9e6b-0113fc0fae5d">
            <body>**CDIF**

Definition
==========

A reference to an external definition of a concept (that is, a concept which is described outside the content of the DDI-CDI metadata description). An example is a SKOS concept. The definition property is assumed to duplicate the external one referenced if externalDefinition is used. Other corresponding properties are assumed to be included unchanged if used.
:jsonName: "cdif:externalDefinition"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_externalDefinition"/>
          </ownedComment>
        </ownedAttribute>
