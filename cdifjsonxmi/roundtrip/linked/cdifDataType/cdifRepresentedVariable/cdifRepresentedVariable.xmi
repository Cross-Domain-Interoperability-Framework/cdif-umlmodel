            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_describedUnitOfMeasure.upper" xmi:uuid="d27a1873-f12b-5390-a407-754259cf1f4f">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_describedUnitOfMeasure.comment" xmi:uuid="ccfcfffa-deb8-5457-8dd7-6afd7ac064fe">
            <body>**CDIF**

Definition
==========

The unit in which the data values are measured (kg, pound, euro), expressed as a value from a controlled system of entries (i.e., QDT). Supports the provision of an identifier for the entry in the authoritative source (a URI, etc.), and the specific vocabulary.
:jsonName: "cdif:describedUnitOfMeasure"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifRepresentedVariable.RepresentedVariable.cdif_describedUnitOfMeasure"/>
          </ownedComment>
        </ownedAttribute>
