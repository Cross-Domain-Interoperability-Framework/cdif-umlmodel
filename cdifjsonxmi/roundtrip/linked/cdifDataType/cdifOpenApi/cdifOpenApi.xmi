        <name>OpenApi</name>
        <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifOpenApi.OpenApi.comment" xmi:uuid="c9b9e48d-4b13-5e74-aba0-d3f2501c00db">
          <body>**CDIF**

Definition
==========

Documents a WebAPI distribution of a resource using property structure aligned with OpenAPI Specification 3.1. Reuses CDIF schema.org-based WebAPI metadata (serviceType, termsOfService, documentation) and adds OpenAPI-aligned Operation, Parameter, RequestBody, and Response structure under an oas namespace. Use as an alternative to schemaorgProperties/webAPI when the metadata record should inline OpenAPI-style operation, parameter, and response detail.
:title: "CDIF OpenAPI-aligned WebAPI distribution"
:rdfType: ``schema:WebAPI``
:noId:</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifOpenApi.OpenApi"/>
        </ownedComment>
        <generalization xmi:type="uml:Generalization" xmi:id="cdif.bbr.metadata.cdifDataType.cdifOpenApi.OpenApi.generalization" xmi:uuid="8514b78c-c42c-582b-9970-41116048014e">
          <general href="../../cdifSharedTypes.xmi#cdif.shared.WebAPI"/>
        </generalization>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifOpenApi.OpenApi.name" xmi:uuid="a5eb9fef-d0c0-547f-9507-eb3cd018214f">
