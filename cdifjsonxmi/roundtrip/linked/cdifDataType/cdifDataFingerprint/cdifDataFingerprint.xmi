      <packagedElement xmi:type="uml:DataType" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDataFingerprint.DataFingerprint" xmi:uuid="92898483-23ec-5c95-a409-7dd711b4401e">
        <name>DataFingerprint</name>
