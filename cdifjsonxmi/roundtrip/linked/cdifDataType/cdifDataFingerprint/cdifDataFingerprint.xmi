          <body>**CDIF**

Definition
==========

A fingerprint (checksum/hash) of a physical dataset, used to verify integrity. DDI-CDI DataFingerprint datatype, carried on a cdi:PhysicalDataSet (schema:DataDownload distribution) via cdi:fingerprint.
:title: "Data Fingerprint"
:prefix: ``cdi``</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifDataFingerprint.DataFingerprint"/>
        </ownedComment>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDataFingerprint.DataFingerprint.value" xmi:uuid="dc5d3352-4006-56a3-912c-39b0ca09cd04">
          <name>value</name>
          <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDataFingerprint.DataFingerprint.value.lower" xmi:uuid="e0c4839b-40af-582b-93a3-8ed59d58a3ed">
            <value>1</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDataFingerprint.DataFingerprint.value.upper" xmi:uuid="db967223-a42d-5d01-9275-678256bb7b86">
            <value>1</value>
          </upperValue>
