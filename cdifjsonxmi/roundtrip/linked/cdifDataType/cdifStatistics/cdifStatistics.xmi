            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifStatistics.Statistics.cdif_appliesTo.upper" xmi:uuid="c0249831-99c7-55d2-88f2-43a6d223e398">
            <value>*</value>
          </upperValue>
          <association xmi:idref="cdif.bbr.metadata.cdifDataType.cdifStatistics.assoc.Statistics_cdif_appliesTo_InstanceVariable"/>
