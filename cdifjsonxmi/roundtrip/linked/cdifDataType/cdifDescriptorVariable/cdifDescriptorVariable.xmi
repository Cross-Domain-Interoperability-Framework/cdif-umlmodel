    <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.model.comment" xmi:uuid="1b05d87c-471c-596a-9831-3087b495ffe9">
      <body>Building block cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable ('DDI-CDI Descriptor Variable'), generated by bblock_to_xmi.py --linked.</body>
      <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.model"/>
    </ownedComment>
    <packagedElement xmi:type="uml:Package" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable" xmi:uuid="cabc6a9e-8f6b-52df-ac61-e3894409c855">
      <name>cdifDescriptorVariable</name>
      <URI>https://w3id.org/cdif/bbr/metadata/cdifDataType/cdifDescriptorVariable</URI>
      <packagedElement xmi:type="uml:Class" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable" xmi:uuid="b1c82b70-dbce-5a27-819b-95c3309d1f2f">
        <name>DescriptorVariable</name>
        <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.comment" xmi:uuid="6755843f-5609-5d80-9ae1-53a9cf12ed9b">
          <body>**CDIF**

Definition
==========

Variable that provides codes for variable identification in the context of a data structure. Descriptor Variables hold values which reference the logical variables in the data set, indicating which one the associated value in the corresponding Reference Variable is a measure/value for. Descriptor Variables are presentational variables found only in Long Data Sets.
:title: "DDI-CDI Descriptor Variable"
:idDescription: "Identifier for this DescriptorVariable node"
:rdfType: ``cdi:DescriptorVariable``</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable"/>
        </ownedComment>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.cdif_hasValuesFrom" xmi:uuid="e59693ef-2ca7-5e11-85ab-585530f9b578">
          <name>cdif_hasValuesFrom</name>
          <type xmi:idref="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorValueDomain"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.cdif_hasValuesFrom.lower" xmi:uuid="f9120afd-9022-5f3f-bcd5-b7a34a24da59">
            <value>1</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.cdif_hasValuesFrom.upper" xmi:uuid="a1551046-2f2c-5ee2-90d1-f8bb8dc9f21a">
            <value>1</value>
          </upperValue>
          <association xmi:idref="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.assoc.DescriptorVariable_cdif_hasValuesFrom_DescriptorValueDomain"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.cdif_hasValuesFrom.comment" xmi:uuid="c48d6e13-d70e-58a6-8e01-80b2d74c4fb0">
            <body>**CDIF**

Definition
==========

A cdi:DescriptorValueDomain enumerating the codes that can appear in the descriptor column, each paired (via cdif:isDefinedBy) with the RepresentedVariable that the code names.
:inlineOrByReference: ``inline``
:jsonName: "cdif:hasValuesFrom"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.cdif_hasValuesFrom"/>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.cdif_name" xmi:uuid="35f9f20a-83a0-598a-a398-dc5e331dbb4b">
          <name>cdif_name</name>
          <type href="../../cdifSharedUnions/StringOrStringList.xmi#cdif.union.StringOrStringList"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.cdif_name.lower" xmi:uuid="02510d1e-d593-59e9-a694-3bcf7bc9e1bc">
            <value>1</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.cdif_name.upper" xmi:uuid="8b296d9a-2382-5a23-9bb2-3b4c3e1827ce">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.cdif_name.comment" xmi:uuid="d9dfc430-e229-5e8d-8a4c-4aa65393e112">
            <body>**CDIF**

Definition
==========

Human understandable name (linguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage.
:jsonName: "cdif:name"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorVariable.cdif_name"/>
          </ownedComment>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorValueDomain" xmi:uuid="211cfa51-218d-5777-8375-ea52352fcc68">
