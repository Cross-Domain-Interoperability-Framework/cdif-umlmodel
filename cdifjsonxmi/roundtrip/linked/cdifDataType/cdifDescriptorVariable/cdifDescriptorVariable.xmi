      <body>Building block cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable ('DDI-CDI Descriptor Variable'), generated by bblock_to_xmi.py --linked.</body>
      <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.model"/>
