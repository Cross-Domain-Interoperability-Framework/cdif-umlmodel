            <value>1</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorValueDomain.cdif_takesValuesFrom.upper" xmi:uuid="e42bceea-479f-53ef-8905-321630b6fd45">
            <value>*</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorValueDomain.cdif_takesValuesFrom.comment" xmi:uuid="30fe23e8-0a77-5f04-a6f8-0538108554d8">
            <body>**CDIF**

Definition
==========

Ordered list of descriptor entries. Each entry has a cdif:value (the code as it appears in the descriptor column) and a cdif:isDefinedBy pointer to the RepresentedVariable that the code names.
:jsonName: "cdif:takesValuesFrom"</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifDescriptorVariable.DescriptorValueDomain.cdif_takesValuesFrom"/>
          </ownedComment>
        </ownedAttribute>
