      <packagedElement xmi:type="uml:Class" xmi:id="cdif.bbr.metadata.cdifDataType.cdifLocatorMapping.LocatorMapping" xmi:uuid="6ef39c05-3c19-5168-a54f-5ef85cf7630c">
        <name>LocatorMapping</name>
        <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifLocatorMapping.LocatorMapping.comment" xmi:uuid="0b20b18f-2a5f-51bb-ade2-b8388b46917b">
          <body>**CDIF**

Definition
==========

Locates a variable's value(s) within a structured (hierarchical) dataset such as XML or JSON, via a locator expression (e.g., XPath or JSONPath). DDI-CDI LocatorMapping. Used in place of column-index/text mappings for cdi:StructuredDataSet distributions.
:title: "Locator Mapping Type"
:rdfType: ``cdif:LocatorMapping``
:typeDescription: "A cdifLocatorMapping instance must be typed cdif:LocatorMapping (not cdif:PhysicalMapping)."
:typeOptional:
:noId:
:extends:
:untypedRoot:</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifLocatorMapping.LocatorMapping"/>
        </ownedComment>
        <generalization xmi:type="uml:Generalization" xmi:id="cdif.bbr.metadata.cdifDataType.cdifLocatorMapping.LocatorMapping.generalization" xmi:uuid="4dee81d9-e7ba-5c10-8084-582e181b9116">
          <general href="../cdifPhysicalMapping/cdifPhysicalMapping.xmi#cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping.PhysicalMapping"/>
        </generalization>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifLocatorMapping.LocatorMapping.cdi_locator" xmi:uuid="2c4fa841-efe8-55a8-819a-453053ae8a34">
          <name>cdi_locator</name>
          <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifLocatorMapping.LocatorMapping.cdi_locator.lower" xmi:uuid="6622eb4e-e559-5704-9d9d-122625c327bf">
            <value>1</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifLocatorMapping.LocatorMapping.cdi_locator.upper" xmi:uuid="c87abb9b-ad7b-5f22-b821-c04c701de0fe">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifLocatorMapping.LocatorMapping.cdi_locator.comment" xmi:uuid="b1c3f3d8-8dbf-57d1-a5a2-87d9ffcb532e">
            <body>**CDIF**

Definition
==========

Expression locating the variable's value(s) in the structured document (XPath, JSONPath, pointer, etc.). LocatorMapping.locator.
:jsonName: "cdi:locator"</body>
