          <body>**CDIF**

Definition
==========

Tabular data type aligned with CDIF 2026 schema using DDI-CDI and CSVW properties. Typed as cdi:TabularTextDataSet.
:title: "Tabular Data Type"
:prefix: ``cdi``
:typeSchema: {"type": "array", "items": {"type": "string"}, "minItems": 2, "allOf": [{"contains": {"const": "cdi:TabularTextDataSet"}}]}
:constraint: {"oneOf": [{"properties": {"cdi:isDelimited": {"const": true}, "cdi:isFixedWidth": {"const": false}}, "required": ["cdi:isDelimited"]}, {"properties": {"cdi:isDelimited": {"const": false}, "cdi:isFixedWidth": {"const": true}}, "required": ["cdi:isFixedWidth"]}]}
:noId:</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifTabularData.TabularData"/>
        </ownedComment>
