          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifProvActivity.ProvActivity.schema_object.lower" xmi:uuid="9aac5ad0-5b17-5ec0-aa17-1d1bb0fec190">
