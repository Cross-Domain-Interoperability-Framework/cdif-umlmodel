    <packagedElement xmi:type="uml:Package" xmi:id="cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping" xmi:uuid="d96c9daa-6f30-5e84-ae74-e8298acafbd7">
      <name>cdifPhysicalMapping</name>
      <URI>https://w3id.org/cdif/bbr/metadata/cdifDataType/cdifPhysicalMapping</URI>
      <packagedElement xmi:type="uml:Class" xmi:id="cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping.PhysicalMapping" xmi:uuid="26968f6a-1c01-5687-92c9-e75fbbc1c18a">
        <name>PhysicalMapping</name>
        <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping.PhysicalMapping.comment" xmi:uuid="ad1b353e-ae19-584b-ada0-cbbffd9b0bd5">
          <body>**CDIF**

Definition
==========

Defines implementation-specific properties for the representation of a variable in a dataset. Aligned with CDIF 2026 schema using DDI-CDI flat per-column mapping structure.
:title: "Physical Mapping Type"
:rdfType: ``cdif:PhysicalMapping | cdif:TextMapping | cdif:LocatorMapping``
:typeDescription: "Must include a physical-mapping family type. A plain physical mapping uses cdif:PhysicalMapping; the cdifTextMapping / cdifLocatorMapping specializations narrow this to cdif:TextMapping / cdif:LocatorMapping respectively (they compose this schema via allOf, so the base accepts any of the family rather than requiring the cdif:PhysicalMapping token)."
:typeOptional:
:constraint: {"if": {"required": ["@type"], "properties": {"@type": {"contains": {"const": "cdif:TextMapping"}}}}, "then": {"required": ["cdif:index"]}}
:constraint: {"if": {"required": ["@type"], "properties": {"@type": {"contains": {"const": "cdif:LocatorMapping"}}}}, "then": {"required": ["cdi:locator"]}}
:noId:</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping.PhysicalMapping"/>
        </ownedComment>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping.PhysicalMapping.index" xmi:uuid="a6972873-4a5b-56bd-aa52-7fedc986e3e9">
          <name>index</name>
          <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#Integer"/>
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping.PhysicalMapping.index.lower" xmi:uuid="253f39f5-d67a-5533-8d79-4f35f6148f08">
            <value>0</value>
          </lowerValue>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping.PhysicalMapping.index.upper" xmi:uuid="fd2cfc08-d166-5cdc-a004-28a9f7d91dcc">
            <value>1</value>
          </upperValue>
          <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping.PhysicalMapping.index.comment" xmi:uuid="5532de35-20c0-59cc-98a8-1d4874c45915">
            <body>**CDIF**

Definition
==========

Non-negative integer that orders the fields in the data structure (column number).
:keywords: {"minimum": 0}</body>
            <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping.PhysicalMapping.index"/>
          </ownedComment>
        </ownedAttribute>
