        <ownedComment xmi:type="uml:Comment" xmi:id="cdif.bbr.metadata.cdifDataType.cdifTextMapping.TextMapping.comment" xmi:uuid="8bd83480-3180-5101-ba39-ec47c3bc8e1c">
          <body>**CDIF**

Definition
==========

Physical mapping for a variable in a delimited or fixed-width text dataset. Extends cdifPhysicalMapping with text-format properties (column width and number formatting). DDI-CDI TextMapping.
:title: "Text Mapping Type"
:rdfType: ``cdif:TextMapping``
:typeDescription: "A cdifTextMapping instance must be typed cdif:TextMapping (not the base cdif:PhysicalMapping). It composes cdifPhysicalMapping via allOf for its properties; the base @type accepts the physical-mapping family."
:typeOptional:
:noId:
:extends:
:untypedRoot:</body>
          <annotatedElement xmi:idref="cdif.bbr.metadata.cdifDataType.cdifTextMapping.TextMapping"/>
        </ownedComment>
        <generalization xmi:type="uml:Generalization" xmi:id="cdif.bbr.metadata.cdifDataType.cdifTextMapping.TextMapping.generalization" xmi:uuid="379d77bc-282f-5fe4-b6d6-352c20acd2d2">
          <general href="../cdifPhysicalMapping/cdifPhysicalMapping.xmi#cdif.bbr.metadata.cdifDataType.cdifPhysicalMapping.PhysicalMapping"/>
        </generalization>
